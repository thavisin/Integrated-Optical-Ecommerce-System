        <mxCell id="title" value="Customer Flow — เลือกซื้อแว่นตา / Checkout สลิป / ประวัติสั่งซื้อ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=15;" vertex="1" parent="1">
