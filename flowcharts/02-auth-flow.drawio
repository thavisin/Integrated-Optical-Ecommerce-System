        </mxCell>
        <mxCell id="s3" value="email ซ้ำ&lt;br&gt;ในระบบ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="135" y="360" width="130" height="80" as="geometry" />
